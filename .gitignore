# Build outputs
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
out/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# CMake
CMakeFiles/
CMakeCache.txt
cmake-build-*/
build/

# Native artifacts copied for managed tests
artifacts/native/*
!artifacts/native/.gitkeep

# NuGet
*.nupkg
packages/

# Release packaging output (tools/package-release.ps1) - a build artifact
# assembled from bin/Release, not something to commit.
/dist/

# OS
Thumbs.db
.DS_Store
thirdparty/mame/

# Real ROMs / ROM sets must never be committed. The ROM Root is an external directory pointed at by
# CHIPESTRA_ROM_ROOT and lives outside the repo; these are defense-in-depth in case
# someone drops a set in-tree.
/roms/
/data/roms/
*.rom
epr-*
mpr-*
opr-*

# Large instruction-trace output files written to the current directory by
# local trace tools (real-ROM-derived output, no reason to be tracked).
gradius_chipestra_*_trace.txt
gradius_mame_*_trace.txt

# vcpkg manifest-mode local install tree (src/Chipestra.Native/vcpkg.json,
# libsoxr) - a build artifact resolved/built by vcpkg per machine.
src/Chipestra.Native/vcpkg_installed/

# MAME's own autogenerated per-system config (mame.exe's default
# -cfg_directory is "cfg" relative to wherever it's invoked from) - a
# side effect of running the reference MAME binary from the repo root,
# not Chipestra repo content.
/cfg/
# Same MAME-runtime-artifact class as /cfg/ above (default -nvram_directory),
# not Chipestra repo content.
/nvram/
