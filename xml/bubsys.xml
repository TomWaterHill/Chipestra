    <resources>
      <rom name="soundcpu" file="400b03.8g" size="8192" crc32="85c2afc5"/>
      <rom name="wave0"    file="400a1.2b"  size="256"  crc32="5827b1e8"/>
      <rom name="wave1"    file="400a2.1b"  size="256"  crc32="2f44f970"/>
    </resources>
    <tracks>
