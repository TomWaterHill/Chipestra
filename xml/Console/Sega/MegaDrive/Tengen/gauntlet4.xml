    <!-- The sound driver is a table of jumps at 0x39E00. The game sets it up with 0x1DBD8, which copies the Z80 program (the sampled sounds)
         into the Z80 RAM and calls 0x39E00. 0x39E04 and 0x39E0C are the routines of the vertical-blank
         interrupt (0x39E0C also plays the sampled sounds through the YM2612 from the 68000), 0x39E10 starts a song (the number in D0).
         An effect is a number the game leaves in a byte of its RAM (0xFFF012, the effect number plus one). 
         The header of the game says Japan, USA and Europe, and the softlist entry used is the Japanese one. -->
    <driver m68k_init="0x1DBD8" m68k_frame="0x39E04 0x39E0C" requests="0x39E10 0xFFF012" warmup_frames="4" region="japan" cart_crc32="f9872055"/>
