    </resources>
    <!-- The cartridge is a Super 32X game, but its music and effects are made on the Mega Drive side only (the 32X processors and PWM are not used for sound, but the PWM unit is shown, silent, as in the other Super 32X games):
         a sound driver in the cartridge (0xC0000 in the file, 0x9C0000 as the 68000 sees it through the 32X window) runs on the 68000 once a frame
         and plays the songs and effects on the YM2612 and the PSG, and loads a small Z80 program for sampled sounds. The game sets a divider in the driver's variables (0xFFF000) so that the sound routine
         runs in five of every six frames (50 times a second on a 60 Hz console); m68k_ram_words_after_init makes that setting. -->
    <driver m68k_init="0x0C0004" m68k_frame="0x0C0000" m68k_ram_words_after_init="0xFFF000=0x0200" request="0xFFF00A" warmup_frames="20" region="japan" z80_reset="released" sh2_comm_word="0x00" cart_window="32x" cart_window_bank="0" cart_crc32="fce4c8c7"/>
