      <!-- The VRC7's built-in instrument table, in the archive ds1001.zip (not part of the game's archive). -->
      <rom name="instruments" file="ds1001_instruments.bin" archive="ds1001" size="144" crc32="9d699efc"/>
    </resources>
    <!-- Konami VRC7 cartridge (mapper 85; the registers are told apart by address line A4). The game's sound driver
         is called as the game's own NMI does: the update routine ($8304) once a frame and, to start a sound, the
         request routine ($80CB) with the sound number in A; $8066 is the driver's start-up routine. The three 8 KB
         banks 0, 1 and 2 are mapped while the routines run (the driver switches $C000 by itself). The driver adds
         1 to the RAM byte $0022 once a frame, and request $2F reads it. Numbers 0x01-0x93 are sounds; 0x01-0x53 and
         0x91-0x93 use the 2A03 only, 0x54-0x90 are songs and short sounds made by the VRC7. 0x00 and 0x94 and
         above are not sounds. -->
    <driver ram_clear="0x0000-0x07FF" init="0x8066" frame="0x8304" request_call="0x80CB"
            prg_banks_call="0 1 2" prg_banks_idle="0 1 2" vrc7_register_line="A4" frame_counter="0x0022"
            prg_crc32="743387ff"/>
