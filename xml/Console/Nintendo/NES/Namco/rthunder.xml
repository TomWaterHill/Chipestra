<chipestra>
  <game id="rolling_thunder_japan" title="Rolling Thunder" manufacturer="Namco"
        machine="NINTENDO_NES" variant="NES_BASE" archive="Rolling Thunder (Japan)">
    <resources>
      <rom name="cart" file="Rolling Thunder (Japan).nes" size="393232" crc32="4837b489"/>
    </resources>
    <!-- Namco 163 cartridge (mapper 19, with the chip's 4 extra sound channels in use). The game's sound driver is
         one routine ($8000), called once a frame with the banks 0x3C and 0x3D mapped at $8000 and $A000 (the third
         bank is not read by the driver); $B307 is its start-up routine. A sound is requested by writing its
         number to the request variable $00B6; the game's own start-up requests 0xFF (the driver's initial state),
         which is already in place. n163_volume="4" is MAME's submapper for this board (the 2A03 is mixed at 0.90
         and the chip at 0.5 x 1.17). 0x80 and 0x9A are the beginnings of songs that go on into a looping song by
         themselves; 0xFE and 0xFF are not sounds. -->
    <driver ram_clear="0x0000-0x07FF" ram_set="0x00B6=0xFF" init="0xB307" frame="0x8000" bgm="0x00B6" sfx="0x00B6"
            prg_banks_call="0x3C 0x3D 0x3E" prg_banks_idle="0x3C 0x3D 0x3E" n163_channels="4" n163_volume="4"
            prg_crc32="3deac303"/>
