    </resources>
    <!-- MMC3 cartridge. The sound driver is in PRG banks 2 and 3 (mapped at $8000 and $A000) and is called through a
         jump table at $8000: $8000 resets it, $8003 starts song X (0-8), $8006 is the update the game calls once a
         frame, $8009 starts sound effect X (0-13). The number is passed in the X register. The driver does not use
         the DMC. Song n is track n+1 of the soundtrack file of the game. Songs 2, 3 and 4 end by themselves. -->
    <driver ram_clear="0x0000-0x07FF" init="0x8000" frame="0x8006" request_call="0x8003" request_register="X" frame_irq="off" mmc3_prg_mode="0"
            sfx_call="0x8009" prg_banks_call="0x02 0x03" prg_banks_idle="0x02 0x03"
            prg_crc32="8c940984" chr_crc32="58e3fe8a"/>
