<Window x:Class="Chipestra.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chipestra - Settings"
        Height="380" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ROM Root" FontWeight="Bold" Margin="0,0,0,8" />
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="RomRootTextBox"
                     Grid.Column="0"
                     Padding="4,4"
                     VerticalContentAlignment="Center"
                     Text="{Binding RomRoot, UpdateSourceTrigger=PropertyChanged}" />
            <Button x:Name="BrowseButton"
                    Grid.Column="1"
                    Content="Browse..."
                    Width="90"
                    Margin="12,0,0,0"
                    Click="BrowseButton_Click" />
        </Grid>

        <StackPanel Grid.Row="2" VerticalAlignment="Top">
            <TextBlock Text="Audio Output" FontWeight="Bold" Margin="0,0,0,8" />
            <ComboBox x:Name="OutputKindComboBox"
                      Width="200"
                      Padding="4,4"
                      HorizontalAlignment="Left"
                      ItemsSource="{Binding AvailableOutputKinds}"
                      SelectedItem="{Binding OutputKind, Mode=TwoWay}" />

            <TextBlock Text="Output Sample Rate" FontWeight="Bold" Margin="0,16,0,8" />
            <ComboBox x:Name="OutputRateComboBox"
                      Width="200"
                      Padding="4,4"
                      HorizontalAlignment="Left"
                      ItemsSource="{Binding AvailableOutputRates}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Hz"
                      SelectedValue="{Binding OutputRateHz, Mode=TwoWay}" />
            <!-- Always shown: shared mode opens at the Windows mixer's own rate, so this is a
                 request, not a command. The per-session "actual vs requested" text is the
                 Output field in the main window's INFORMATION row. -->
            <TextBlock Text="{Binding OutputRateNote}" TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.7" />
        </StackPanel>

        <!-- License is on the opposite side from OK/Cancel so it does not read as a third commit action. -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="LicenseButton" Grid.Column="0" Content="License" Width="90" Click="LicenseButton_Click" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="OkButton" Content="OK" Width="80" Margin="0,0,12,0" IsDefault="True" Click="OkButton_Click" />
                <Button x:Name="CancelButton" Content="Cancel" Width="80" IsCancel="True" Click="CancelButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
