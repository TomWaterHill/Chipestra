<Window x:Class="Chipestra.App.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chipestra - License"
        Height="600" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}">
    <!-- Version heading + THIRD-PARTY-NOTICES.md, licenses/*.txt and LICENSE (LicenseTextBuilder) in a read-only, scrollable TextBox. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="VersionTextBlock" Grid.Row="0" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />

        <TextBox x:Name="LicenseTextBox"
                 Grid.Row="1"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 Padding="8" />

        <Button x:Name="CloseButton"
                Grid.Row="2"
                Content="Close"
                Width="90"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                IsDefault="True"
                IsCancel="True"
                Click="CloseButton_Click" />
    </Grid>
</Window>
